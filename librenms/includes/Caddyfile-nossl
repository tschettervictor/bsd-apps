yourhostnamehere:80, :80 {
    root * /usr/local/www/librenms/html
    file_server

	@forbidden {
		path /.htaccess
	}
    respond @forbidden 404

    @api path /api/v0/*
    handle @api {
      rewrite * /api_v0.php?{query}
    }

    handle {
        try_files {path} {path}/ /index.php?{query}
    }

    php_fastcgi 127.0.0.1:9000
}