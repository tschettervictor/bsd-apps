{
	# debug
	# default_sni yourhostnamehere
}

yourhostnamehere {
    root * /usr/local/www/librenms/html
    file_server
	log {
		output file /var/log/yourhostnamehere.log
	}

    php_fastcgi 127.0.0.1:9000

	tls /usr/local/etc/pki/tls/certs/fullchain.pem /usr/local/etc/pki/tls/private/privkey.pem

    @api path /api/v0/*
    handle @api {
      rewrite * /api_v0.php?{uri}
    }

    try_files {path} {path}/ /index.php?{uri}

	@forbidden {
		path /.htaccess
	}

	respond @forbidden 404
}